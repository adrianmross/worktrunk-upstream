---
source: tests/integration_tests/step_doctor.rs
info:
  program: wt
  args:
    - step
    - doctor
  env:
    APPDATA: "[TEST_CONFIG_HOME]"
    CLAUDE_CONFIG_DIR: "[TEST_CLAUDE_CONFIG]"
